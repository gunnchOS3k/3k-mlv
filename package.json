{
  "name": "3k-mlv",
  "version": "1.0.0",
  "description": "3k MLV (My Little Vicinity) - Cozy multiplayer portfolio hub",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter mlv-web dev",
    "build": "pnpm --filter mlv-web build",
    "preview": "pnpm --filter mlv-web preview",
    "dev:anime": "pnpm --filter anime-aggressors dev",
    "build:anime": "pnpm --filter anime-aggressors build",
    "clean": "pnpm -r clean",
    "type-check": "pnpm --filter mlv-web type-check",
    "test": "node --test tests/privacy/*.test.mjs tests/campus/*.test.mjs tests/network_twin/*.test.mjs",
    "campus:artifacts": "node scripts/build-campus-artifacts.mjs",
    "network-twin:artifacts": "node scripts/build-network-twin-artifacts.mjs",
    "test:rls": "node scripts/run-local-postgres-rls.mjs",
    "assert:no-node-modules": "bash scripts/assert-no-tracked-node-modules.sh",
    "scan:secrets": "bash scripts/scan-no-secrets.sh",
    "test:privacy": "node --test tests/privacy/*.test.mjs",
    "test:campus": "node --test tests/campus/*.test.mjs",
    "test:hosted": "node scripts/run-hosted-supabase-acceptance.mjs"
  },
  "packageManager": "pnpm@9.15.9",
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.7",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9.15.0 <10"
  },
  "keywords": [
    "portfolio",
    "multiplayer",
    "3d",
    "cozy",
    "social",
    "gaming"
  ],
  "author": "gunnchOS3k",
  "license": "MIT"
}
