{
  "name": "3k-mlv",
  "version": "1.0.0",
  "description": "3k MLV (My Little Vicinity) - Cozy multiplayer portfolio hub",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter mlv-web dev",
    "build": "pnpm --filter mlv-web build",
    "preview": "pnpm --filter mlv-web preview",
    "dev:anime": "pnpm --filter anime-aggressors dev",
    "build:anime": "pnpm --filter anime-aggressors build",
    "clean": "pnpm -r clean",
    "type-check": "pnpm -r type-check"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "@types/node": "^20.10.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "keywords": [
    "portfolio",
    "multiplayer",
    "3d",
    "cozy",
    "social",
    "gaming"
  ],
  "author": "gunnchOS3k",
  "license": "MIT"
}
