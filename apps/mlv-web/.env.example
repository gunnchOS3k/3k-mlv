# Copy to .env.local. Never commit real keys.
# Anon key only. Never put the service-role key, OAuth client secret, or JWT signing key here.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Public gateway return. Not a secret.
# Unset, blank, or any *.gunnchos-finds.workers.dev host returns to https://gunnchos.com.
# Set another public https origin only when a different guest gateway is intended.
# VITE_GUNNCHOS_PORTAL_URL=https://gunnchos.com
